# Biến cho docker compose. Tạo .env bằng:  python scripts/init_env.py   (sinh mật khẩu ngẫu nhiên)
# hoặc sao chép tệp này thành .env và tự điền. Dùng ký tự chữ-số để khỏi phải mã hóa URL.
POSTGRES_PASSWORD=
AIK08_READER_PASSWORD=
AIK08_APP_PASSWORD=

# Khóa API cho backend (init_env.py tự sinh; >= 16 ký tự). UI hỏi khóa này khi mở lần đầu.
API_KEYS=

# Chỉ cần khi bật pgAdmin:  docker compose --profile tools up
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
