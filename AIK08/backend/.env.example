# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG đưa .env hoặc API key vào Git hay gói nộp.
# Khi chạy bằng docker compose, kết nối CSDL được compose đặt sẵn; chỉ cần các mục LLM bên dưới.

# --- CSDL (chỉ cần khi chạy backend ngoài docker; để trống thì dùng mặc định dev trong app/config.py) ---
# OWNER_DATABASE_URL=postgresql://<owner>:<mật-khẩu>@127.0.0.1:5432/aik08
# READER_DATABASE_URL=postgresql://aik08_reader:<mật-khẩu>@127.0.0.1:5432/aik08
# APP_DATABASE_URL=postgresql://aik08_app:<mật-khẩu>@127.0.0.1:5432/aik08
VECTOR_SEARCH=auto

# --- Hạn mức phiên ---
MAX_STEPS=10
MAX_TOKENS=20000
MAX_SECONDS=60
SYNTHESIS_RESERVE_TOKENS=2500
MAX_CONSECUTIVE_VIOLATIONS=3
MAX_CONCURRENT_SESSIONS=4

# --- LLM: mock (offline) | google | openai | multi ---
# MOCK_LLM_DELAY_SECONDS=0   # chỉ cho mock: giả lập độ trễ mỗi lời gọi LLM để thử nút Hủy
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Xác thực API (BẮT BUỘC) ---
# Một hoặc nhiều khóa, phân tách bằng dấu phẩy, mỗi khóa >= 16 ký tự. Tạo: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Gửi qua header  X-API-Key: <khóa>  hoặc  Authorization: Bearer <khóa>. Thiếu khóa thì API không khởi động.
# /health và /demo/* (dữ liệu tĩnh, GET) không cần khóa. Chỉ khi chạy thử cục bộ: API_AUTH_DISABLED=true
API_KEYS=
# API_AUTH_DISABLED=false

# --- Công cụ HTTP GET: chỉ gọi được URL nằm DƯỚI các tiền tố liệt kê (phân tách bằng dấu phẩy) ---
# Mặc định: <PUBLIC_BASE_URL>/demo/  (API demo chỉ-đọc có sẵn trong backend; tắt bằng ENABLE_DEMO_API=false)
PUBLIC_BASE_URL=http://127.0.0.1:8000
ENABLE_DEMO_API=true
# API_ALLOWED_URL_PREFIXES=http://127.0.0.1:8000/demo/
HTTP_TIMEOUT_SECONDS=8
HTTP_MAX_BYTES=200000

# --- Phục hồi phiên mồ côi và thời gian dành cho báo cáo ---
# RECOVER_ON_START=true giả định MỘT tiến trình API; đặt false nếu chạy nhiều worker.
RECOVER_ON_START=true
ORPHAN_GRACE_SECONDS=30
SWEEP_INTERVAL_SECONDS=30
MIN_SYNTHESIS_SECONDS=15

# --- OpenTelemetry: none | console | otlp ---
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=aik08-agent

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
