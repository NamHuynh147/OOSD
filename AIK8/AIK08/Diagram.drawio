        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Kiến trúc hệ thống AIK-08 - mô hình phân tầng\n\nskinparam style strictuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam roundcorner 0\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam packageStyle rectangle\nskinparam nodesep 25\nskinparam ranksep 35\n\npackage \&quot;Tầng giao diện\&quot; {\n  [Giao diện người dùng\\n(WinForms hoặc React)] as UI\n}\n\npackage \&quot;Tầng API\&quot; {\n  [API điều khiển phiên\\n(FastAPI, REST)] as API\n}\n\npackage \&quot;Tầng ứng dụng\&quot; {\n  [AgentOrchestrator] as ORCH\n  [Planner] as PLAN\n  [PromptBuilder] as PB\n  [ReportSynthesizer] as SYN\n}\n\npackage \&quot;Tầng bảo vệ (bọc mọi tool)\&quot; {\n  [GuardedTool] as GT\n  [ToolPolicy\\n(allowlist)] as TP\n  [BudgetGuard\\n(ngân sách)] as BG\n  [InjectionGuard\\n(nội dung nguồn)] as IG\n}\n\npackage \&quot;Tầng công cụ (chỉ đọc)\&quot; {\n  [ToolRegistry] as REG\n  [DocumentSearchTool\\nDocumentReadTool] as DOC\n  [HttpGetApiTool] as HTTP\n}\n\npackage \&quot;Tầng hạ tầng\&quot; {\n  [LlmClient] as LLM\n  [EvidenceStore] as ES\n  [TraceRecorder] as TR\n}\n\ndatabase \&quot;PostgreSQL\\n(kèm vector store)\&quot; as DB\ncloud \&quot;LLM Provider\&quot; as LLMP\ncloud \&quot;API nguồn ngoài\&quot; as EXT\n[OpenTelemetry\\nCollector] as OTEL\n\nUI --&gt; API : REST\nAPI --&gt; ORCH : runAgent\nORCH --&gt; PLAN\nORCH --&gt; PB\nORCH --&gt; SYN\nORCH --&gt; REG : lấy tool được phép\nORCH --&gt; GT : gọi tool\nGT --&gt; TP\nGT --&gt; BG\nGT --&gt; IG\nGT --&gt; DOC : ủy quyền\nGT --&gt; HTTP : ủy quyền\nPLAN --&gt; LLM\nSYN --&gt; LLM\nORCH --&gt; LLM\nORCH --&gt; ES\nORCH --&gt; TR\nLLM --&gt; LLMP : HTTPS\nHTTP --&gt; EXT : HTTP GET\nDOC --&gt; DB : SELECT (vai trò chỉ đọc)\nES --&gt; DB : ghi Evidence\nAPI --&gt; DB : đọc phiên, báo cáo\nTR --&gt; OTEL : OTLP\n\nnote right of GT\n  Decorator: mọi lời gọi tool\n  đều đi qua ToolPolicy,\n  BudgetGuard, InjectionGuard.\n  Không có đường đi vòng.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OLQW56Dg2os7pJmIFz21-1">
