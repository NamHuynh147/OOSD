  <diagram id="uv74mVl0M0MEjtVoJdxJ" name="Page-26">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nnamespace Domain {\n    class ResearchSession {\n        +id : UUID\n        +question : string\n        +status : SessionStatus\n        +maxSteps : int\n        +maxTokens : int\n        +maxSeconds : int\n        +createdAt : datetime\n        +cancel() void\n    }\n    class PlanStep {\n        +seq : int\n        +description : string\n    }\n    class ToolCall {\n        +id : UUID\n        +toolName : string\n        +args : json\n        +blocked : bool\n        +calledAt : datetime\n    }\n    class Evidence {\n        +id : UUID\n        +locator : string\n        +content : text\n        +hash : string\n        +retrievedAt : datetime\n    }\n    class GuardFinding {\n        +kind : string\n        +detail : string\n    }\n    class Report {\n        +id : UUID\n        +body : text\n        +createdAt : datetime\n    }\n    class Claim {\n        +id : UUID\n        +text : string\n        +hasSource() bool\n    }\n    class Citation {\n        +quote : string\n    }\n    class Source {\n        +id : UUID\n        +name : string\n        +type : string\n        +enabled : bool\n    }\n    class AdminPolicy {\n        +allowedTools : string[]\n        +defaultMaxSteps : int\n        +defaultMaxTokens : int\n        +defaultMaxSeconds : int\n    }\n    class SessionStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        running\n        completed\n        budget_exhausted\n        cancelled\n        error\n    }\n}\n\nnamespace Application {\n    class AgentOrchestrator {\n        +run(session) Report\n        -step(session) void\n    }\n    class Planner {\n        +plan(question) PlanStep[]\n    }\n    class PromptBuilder {\n        +build(session, evidences) string\n    }\n    class ReportSynthesizer {\n        +synthesize(session, evidences) Report\n    }\n}\n\nnamespace Guards {\n    class GuardedTool {\n        -inner : ReadOnlyTool\n        +name() string\n        +execute(args) Evidence\n    }\n    class ToolPolicy {\n        +isAllowed(toolName) bool\n    }\n    class BudgetGuard {\n        +check(session) void\n        +consume(tokens, seconds) void\n    }\n    class InjectionGuard {\n        +scan(content) GuardFinding[]\n    }\n}\n\nnamespace Tools {\n    class ReadOnlyTool {\n        &lt;&lt;interface&gt;&gt;\n        +name() string\n        +execute(args) Evidence\n    }\n    class DocumentSearchTool {\n        +execute(args) Evidence\n    }\n    class DocumentReadTool {\n        +execute(args) Evidence\n    }\n    class HttpGetApiTool {\n        +execute(args) Evidence\n    }\n    class ToolRegistry {\n        +get(name) ReadOnlyTool\n        +allowed(policy) ReadOnlyTool[]\n    }\n}\n\nnamespace Infrastructure {\n    class LlmClient {\n        &lt;&lt;interface&gt;&gt;\n        +complete(prompt) LlmResult\n    }\n    class RealLlmClient\n    class FakeLlmClient\n    class EvidenceStore {\n        +save(evidence) void\n        +find(id) Evidence\n    }\n    class TraceRecorder {\n        +record(event) void\n    }\n}\n\n%% Miền\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; PlanStep : có\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; ToolCall : gồm\nResearchSession \&quot;1\&quot; *-- \&quot;0..1\&quot; Report : sinh ra\nResearchSession --&gt; SessionStatus\nToolCall \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Evidence : thu được\nToolCall \&quot;1\&quot; --&gt; \&quot;0..*\&quot; GuardFinding : bị cảnh báo\nReport \&quot;1\&quot; *-- \&quot;0..*\&quot; Claim : chứa\nClaim \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Citation : dẫn\nCitation \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Evidence : trỏ tới\nEvidence \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Source : lấy từ\n\n%% Ứng dụng\nAgentOrchestrator --&gt; Planner\nAgentOrchestrator --&gt; PromptBuilder\nAgentOrchestrator --&gt; ReportSynthesizer\nAgentOrchestrator --&gt; ToolRegistry\nAgentOrchestrator --&gt; GuardedTool : gọi tool\nAgentOrchestrator --&gt; LlmClient\nAgentOrchestrator --&gt; EvidenceStore\nAgentOrchestrator --&gt; TraceRecorder\nAgentOrchestrator ..&gt; ResearchSession\nPlanner --&gt; LlmClient\nReportSynthesizer --&gt; LlmClient\n\n%% Bảo vệ (Decorator)\nGuardedTool ..|&gt; ReadOnlyTool\nGuardedTool o-- \&quot;1\&quot; ReadOnlyTool : bọc\nGuardedTool --&gt; ToolPolicy\nGuardedTool --&gt; BudgetGuard\nGuardedTool --&gt; InjectionGuard\nToolPolicy ..&gt; AdminPolicy\n\n%% Công cụ\nDocumentSearchTool ..|&gt; ReadOnlyTool\nDocumentReadTool ..|&gt; ReadOnlyTool\nHttpGetApiTool ..|&gt; ReadOnlyTool\nToolRegistry o-- \&quot;0..*\&quot; ReadOnlyTool\n\n%% Hạ tầng\nRealLlmClient ..|&gt; LlmClient\nFakeLlmClient ..|&gt; LlmClient\nEvidenceStore ..&gt; Evidence&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="AJM_pBfc7HrYt_wax6Te-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontStyle=1;fontSize=16;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
