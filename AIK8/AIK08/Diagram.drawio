        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ERD - AIK-08 (PostgreSQL)\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\n\nentity \&quot;admin_policy\&quot; as admin_policy {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * allowlist : text[]\n  * default_max_steps : integer\n  * default_max_tokens : integer\n  * default_max_seconds : integer\n}\n\nentity \&quot;sources\&quot; as sources {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * kind : text\n  * uri : text\n  * display_name : text\n  * enabled : boolean\n}\n\nentity \&quot;document_chunks\&quot; as document_chunks {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * source_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * text : text\n}\n\nentity \&quot;research_sessions\&quot; as research_sessions {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * question : text\n  * status : text\n  * allowlist : text[]\n  * max_steps : integer\n  * max_tokens : integer\n  * max_seconds : integer\n  * used_steps : integer\n  * used_tokens : integer\n  * used_seconds : integer\n  * started_at : timestamptz\n  ended_at : timestamptz\n  end_reason : text\n}\n\nentity \&quot;plan_steps\&quot; as plan_steps {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * goal : text\n  * status : text\n}\n\nentity \&quot;tool_calls\&quot; as tool_calls {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  step_id : integer &lt;&lt;FK&gt;&gt;\n  * tool_name : text\n  * arguments : jsonb\n  * outcome : text\n  * guard_decision : text\n  guard_reason : text\n  * duration_ms : integer\n  * created_at : timestamptz\n}\n\nentity \&quot;evidence\&quot; as evidence {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * tool_call_id : integer &lt;&lt;FK&gt;&gt;\n  * source_id : integer &lt;&lt;FK&gt;&gt;\n  * locator : text\n  * excerpt : text\n  * content_hash : text\n  * retrieved_at : timestamptz\n  * suspicious : boolean\n}\n\nentity \&quot;guard_findings\&quot; as guard_findings {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  tool_call_id : integer &lt;&lt;FK&gt;&gt;\n  evidence_id : integer &lt;&lt;FK&gt;&gt;\n  * kind : text\n  * severity : text\n  * detail : text\n}\n\nentity \&quot;reports\&quot; as reports {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK, UNIQUE&gt;&gt;\n  * body : text\n  * end_reason : text\n  * created_at : timestamptz\n}\n\nentity \&quot;claims\&quot; as claims {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * report_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * text : text\n  * status : text\n}\n\nentity \&quot;citations\&quot; as citations {\n  * claim_id : integer &lt;&lt;PK, FK&gt;&gt;\n  * evidence_id : integer &lt;&lt;PK, FK&gt;&gt;\n  --\n  * matched_excerpt : text\n}\n\nsources ||--o{ document_chunks : \&quot;có đoạn\&quot;\nsources ||--o{ evidence : \&quot;là nguồn của\&quot;\nresearch_sessions ||--o{ plan_steps : \&quot;có bước\&quot;\nresearch_sessions ||--o{ tool_calls : \&quot;gồm\&quot;\nresearch_sessions ||--o{ guard_findings : \&quot;ghi nhận\&quot;\nresearch_sessions ||--o| reports : \&quot;tạo ra\&quot;\nplan_steps |o--o{ tool_calls : \&quot;thực hiện\&quot;\ntool_calls ||--o{ evidence : \&quot;sinh ra\&quot;\ntool_calls |o--o{ guard_findings : \&quot;gây ra\&quot;\nevidence |o--o{ guard_findings : \&quot;bị đánh dấu\&quot;\nreports ||--o{ claims : \&quot;gồm\&quot;\nclaims ||--o{ citations : \&quot;trích dẫn\&quot;\nevidence ||--o{ citations : \&quot;được trích\&quot;\n\nnote right of evidence\n  Bất biến: trigger chặn UPDATE và DELETE\nend note\n\nnote bottom of admin_policy\n  Đúng 1 dòng (id = 1).\n  Phiên sao allowlist và hạn mức lúc tạo.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r4dxYICDhb9FSnRg_xOt-202">
