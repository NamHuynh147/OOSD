  <diagram id="CoPUbTfEGNrrT9X_IINh" name="clas">
    <mxGraphModel dx="2575" dy="1308" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - AIK-08 (hệ thống điều phối agent tra cứu read-only)\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\n\npackage \&quot;Miền (domain)\&quot; {\n  enum SessionStatus {\n    RUNNING\n    COMPLETED\n    BUDGET_EXHAUSTED\n    CANCELLED\n    ERROR\n  }\n\n  class ResearchSession {\n    -id : int\n    -question : String\n    -status : SessionStatus\n    -startedAt : DateTime\n    -endedAt : DateTime\n    -endReason : String\n    +finish(status : SessionStatus, reason : String) : void\n  }\n\n  class Budget {\n    -maxSteps : int\n    -maxTokens : int\n    -maxSeconds : int\n    -usedSteps : int\n    -usedTokens : int\n    -usedSeconds : int\n    +canAfford(cost : Cost) : boolean\n    +consume(cost : Cost) : void\n  }\n\n  class ToolPolicy {\n    -allowedTools : Set&lt;String&gt;\n    +isAllowed(toolName : String) : boolean\n  }\n\n  class ToolDefinition {\n    -name : String\n    -description : String\n    -parameterSchema : String\n    -kind : String\n    -readOnly : boolean = true\n  }\n\n  class Plan {\n    +currentStep() : PlanStep\n    +markDone(step : PlanStep) : void\n  }\n\n  class PlanStep {\n    -position : int\n    -goal : String\n    -status : String\n  }\n\n  class ToolCall {\n    -toolName : String\n    -arguments : String\n    -outcome : String\n    -guardDecision : String\n    -guardReason : String\n    -durationMs : int\n  }\n\n  class Source {\n    -kind : String\n    -uri : String\n    -displayName : String\n    -enabled : boolean\n  }\n\n  class Evidence {\n    -locator : String\n    -excerpt : String\n    -contentHash : String\n    -retrievedAt : DateTime\n    -suspicious : boolean\n  }\n\n  class GuardFinding {\n    -kind : String\n    -severity : String\n    -detail : String\n  }\n\n  class Report {\n    -body : String\n    -endReason : String\n    -createdAt : DateTime\n  }\n\n  class Claim {\n    -position : int\n    -text : String\n    -status : String\n  }\n\n  class Citation {\n    -matchedExcerpt : String\n  }\n}\n\npackage \&quot;Ứng dụng (application)\&quot; {\n  class AgentOrchestrator {\n    +run(session : ResearchSession) : Report\n    +cancel(sessionId : int) : void\n    -nextToolCall() : ToolCall\n  }\n\n  class Planner {\n    +createPlan(question : String) : Plan\n    +revise(plan : Plan, evidence : Evidence) : Plan\n  }\n\n  class PromptBuilder {\n    +buildToolPrompt(plan : Plan, tools : List&lt;ToolDefinition&gt;) : String\n    +wrapUntrusted(content : String) : String\n  }\n\n  class ReportSynthesizer {\n    +synthesize(session : ResearchSession) : Report\n    -verifyClaims(claims : List&lt;Claim&gt;) : void\n  }\n}\n\npackage \&quot;Bảo vệ (guards)\&quot; {\n  class GuardDecision {\n    -allowed : boolean\n    -reason : String\n  }\n\n  class BudgetGuard {\n    +checkBudget(sessionId : int, cost : Cost) : GuardDecision\n    +recordUsage(sessionId : int, tokens : int, seconds : int) : void\n  }\n\n  class InjectionGuard {\n    +scan(content : String) : boolean\n    +sanitize(content : String) : String\n  }\n\n  class GuardedTool {\n    +execute(sessionId : int, args : Map) : ToolResult\n  }\n}\n\npackage \&quot;Công cụ (tools)\&quot; {\n  interface ReadOnlyTool {\n    +name() : String\n    +definition() : ToolDefinition\n    +validate(args : Map) : void\n    +read(args : Map) : ToolResult\n  }\n\n  class ToolResult {\n    -content : String\n    -locator : String\n    -sourceId : int\n  }\n\n  class DocumentSearchTool\n  class DocumentReadTool\n  class HttpGetApiTool {\n    -allowedHosts : Set&lt;String&gt;\n  }\n\n  class ToolRegistry {\n    +toolsFor(policy : ToolPolicy) : List&lt;ReadOnlyTool&gt;\n    +create(name : String, policy : ToolPolicy) : GuardedTool\n  }\n}\n\npackage \&quot;Hạ tầng (infrastructure)\&quot; {\n  interface LlmClient {\n    +complete(prompt : String) : String\n    +proposeToolCall(prompt : String) : ToolCall\n  }\n\n  class RealLlmClient\n  class FakeLlmClient\n\n  class EvidenceStore {\n    +save(evidence : Evidence) : int\n    +find(id : int) : Evidence\n  }\n\n  class TraceRecorder {\n    +span(name : String) : void\n    +publish(event : String) : void\n  }\n}\n\nnote right of ReadOnlyTool\n  Không có phương thức ghi:\n  chỉ đọc được ép bằng kiểu\nend note\n\n&#39; Miền\nResearchSession \&quot;1\&quot; *-- \&quot;1\&quot; Budget\nResearchSession \&quot;1\&quot; *-- \&quot;1\&quot; ToolPolicy\nResearchSession \&quot;1\&quot; *-- \&quot;1\&quot; Plan\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; ToolCall\nResearchSession \&quot;1\&quot; *-- \&quot;0..1\&quot; Report\nResearchSession --&gt; SessionStatus\nPlan \&quot;1\&quot; *-- \&quot;1..*\&quot; PlanStep\nToolCall \&quot;1\&quot; *-- \&quot;0..*\&quot; Evidence : sinh ra\nEvidence \&quot;*\&quot; --&gt; \&quot;1\&quot; Source\nReport \&quot;1\&quot; *-- \&quot;0..*\&quot; Claim\nClaim \&quot;1\&quot; -- \&quot;0..*\&quot; Citation\nCitation \&quot;*\&quot; --&gt; \&quot;1\&quot; Evidence\nGuardFinding \&quot;*\&quot; --&gt; \&quot;1\&quot; ResearchSession\nGuardFinding \&quot;*\&quot; --&gt; \&quot;0..1\&quot; ToolCall\nGuardFinding \&quot;*\&quot; --&gt; \&quot;0..1\&quot; Evidence\nToolPolicy ..&gt; ToolDefinition : tham chiếu theo tên\n\n&#39; Ứng dụng\nAgentOrchestrator --&gt; Planner\nAgentOrchestrator --&gt; PromptBuilder\nAgentOrchestrator --&gt; LlmClient\nAgentOrchestrator --&gt; ToolRegistry\nAgentOrchestrator --&gt; EvidenceStore\nAgentOrchestrator --&gt; ReportSynthesizer\nAgentOrchestrator --&gt; TraceRecorder\nAgentOrchestrator ..&gt; ResearchSession\nPlanner --&gt; LlmClient\nReportSynthesizer --&gt; LlmClient\nReportSynthesizer --&gt; EvidenceStore\n\n&#39; Bảo vệ và công cụ\nGuardedTool ..|&gt; ReadOnlyTool\nGuardedTool o-- \&quot;1\&quot; ReadOnlyTool : inner (Decorator)\nGuardedTool --&gt; ToolPolicy\nGuardedTool --&gt; BudgetGuard\nGuardedTool --&gt; InjectionGuard\nBudgetGuard --&gt; Budget\nBudgetGuard ..&gt; GuardDecision\nInjectionGuard ..&gt; Evidence : đánh dấu suspicious\nDocumentSearchTool ..|&gt; ReadOnlyTool\nDocumentReadTool ..|&gt; ReadOnlyTool\nHttpGetApiTool ..|&gt; ReadOnlyTool\nReadOnlyTool ..&gt; ToolResult\nToolRegistry o-- \&quot;*\&quot; ReadOnlyTool\nToolRegistry ..&gt; GuardedTool : &lt;&lt;create&gt;&gt; (Factory)\n\n&#39; Hạ tầng\nRealLlmClient ..|&gt; LlmClient\nFakeLlmClient ..|&gt; LlmClient\nEvidenceStore ..&gt; Evidence\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="efe4lIqY8RqkgPsC_ilT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
