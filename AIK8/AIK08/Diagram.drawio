      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - UC-01: Gửi yêu cầu tra cứu\nskinparam conditionStyle inside\n\nstart\n:Người dùng nhập câu hỏi, chọn nguồn và đặt hạn mức;\n:Hệ thống tạo phiên, chốt allowlist và Budget;\n:Planner tách yêu cầu thành các bước tra cứu;\nrepeat\n  :Orchestrator gọi LLM chọn Tool;\n  if (Tool có trong allowlist?) then (Không)\n    :Từ chối, ghi log, báo LLM chọn lại;\n  else (Có)\n    if (Còn ngân sách/thời gian?) then (Không)\n      :Dừng lặp, ghi nhận lý do hết hạn mức;\n      break\n    else (Có)\n      :Gọi Tool (chỉ đọc) lấy dữ liệu;\n      if (Phát hiện Prompt Injection?) then (Có)\n        :Đánh dấu độc hại, cô lập nội dung;\n      else (Không)\n      endif\n      :Lưu dữ liệu, bằng chứng vào Evidence Store;\n    endif\n  endif\nrepeat while (Đủ dữ liệu hoặc hết ngân sách?) is (Chưa đủ)\n-&gt; Đã đủ hoặc hết hạn mức;\n:ReportSynthesizer tổng hợp báo cáo, gắn trích dẫn;\n:Lưu báo cáo và hiển thị cho người dùng;\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rCM6A1iVHd36tWyz5UyH-1">
