  <diagram id="w88hPhKfb05aV5MnBl4-" name="Page-24">
    <mxGraphModel dx="1241" dy="630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Các lớp lưu xuống CSDL (AIK-08)\n\nskinparam style strictuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam roundcorner 0\nskinparam classAttributeIconSize 0\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam nodesep 40\nskinparam ranksep 50\nhide circle\nhide empty members\n\nenum SessionStatus {\n  RUNNING\n  COMPLETED\n  BUDGET_EXHAUSTED\n  CANCELLED\n  ERROR\n}\n\nenum ClaimStatus {\n  SOURCED\n  UNSOURCED\n}\n\nenum FindingKind {\n  NOT_ALLOWLISTED\n  BUDGET_EXCEEDED\n  INJECTION_SUSPECTED\n  UNSUPPORTED_CLAIM\n}\n\nclass AdminPolicy &lt;&lt;bảng admin_policy&gt;&gt; {\n  -id : int\n  -allowlist : List&lt;String&gt;\n  -defaultMaxSteps : int\n  -defaultMaxTokens : int\n  -defaultMaxSeconds : int\n}\n\nclass Source &lt;&lt;bảng sources&gt;&gt; {\n  -id : int\n  -kind : String\n  -uri : String\n  -displayName : String\n  -enabled : boolean\n}\n\nclass DocumentChunk &lt;&lt;bảng document_chunks&gt;&gt; {\n  -id : int\n  -position : int\n  -text : String\n}\n\nclass ResearchSession &lt;&lt;bảng research_sessions&gt;&gt; {\n  -id : int\n  -question : String\n  -status : SessionStatus\n  -allowlist : List&lt;String&gt;\n  -maxSteps : int\n  -maxTokens : int\n  -maxSeconds : int\n  -usedSteps : int\n  -usedTokens : int\n  -usedSeconds : int\n  -startedAt : DateTime\n  -endedAt : DateTime\n  -endReason : String\n  +canAfford(cost : Cost) : boolean\n  +finish(status : SessionStatus, reason : String) : void\n}\n\nclass PlanStep &lt;&lt;bảng plan_steps&gt;&gt; {\n  -id : int\n  -position : int\n  -goal : String\n  -status : String\n}\n\nclass ToolCall &lt;&lt;bảng tool_calls&gt;&gt; {\n  -id : int\n  -toolName : String\n  -arguments : String\n  -outcome : String\n  -guardDecision : String\n  -guardReason : String\n  -durationMs : int\n  -createdAt : DateTime\n}\n\nclass Evidence &lt;&lt;bảng evidence&gt;&gt; {\n  -id : int\n  -locator : String\n  -excerpt : String\n  -contentHash : String\n  -retrievedAt : DateTime\n  -suspicious : boolean\n}\n\nclass GuardFinding &lt;&lt;bảng guard_findings&gt;&gt; {\n  -id : int\n  -kind : FindingKind\n  -severity : String\n  -detail : String\n}\n\nclass Report &lt;&lt;bảng reports&gt;&gt; {\n  -id : int\n  -body : String\n  -endReason : String\n  -createdAt : DateTime\n  +addClaim(claim : Claim) : void\n}\n\nclass Claim &lt;&lt;bảng claims&gt;&gt; {\n  -id : int\n  -position : int\n  -text : String\n  -status : ClaimStatus\n  +isSourced() : boolean\n}\n\nclass Citation &lt;&lt;bảng citations&gt;&gt; {\n  -matchedExcerpt : String\n}\n\nResearchSession --&gt; SessionStatus\nClaim --&gt; ClaimStatus\nGuardFinding --&gt; FindingKind\n\nSource \&quot;1\&quot; *-- \&quot;0..*\&quot; DocumentChunk : gồm đoạn\nEvidence \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Source : lấy từ\n\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; PlanStep : có bước\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; ToolCall : gồm lời gọi\nResearchSession \&quot;1\&quot; *-- \&quot;0..*\&quot; GuardFinding : ghi nhận cảnh báo\nResearchSession \&quot;1\&quot; *-- \&quot;0..1\&quot; Report : tạo ra\n\nToolCall \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; PlanStep : thuộc bước\nToolCall \&quot;1\&quot; *-- \&quot;0..*\&quot; Evidence : sinh ra\n\nGuardFinding \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; ToolCall : về lời gọi\nGuardFinding \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Evidence : về bằng chứng\n\nReport \&quot;1\&quot; *-- \&quot;0..*\&quot; Claim : gồm khẳng định\nClaim \&quot;0..*\&quot; -- \&quot;0..*\&quot; Evidence : trích dẫn\n(Claim, Evidence) .. Citation\n\nnote right of Evidence\n  Bất biến sau khi tạo:\n  không có phương thức sửa,\n  CSDL chặn UPDATE và DELETE\nend note\n\nnote bottom of ResearchSession\n  Budget và ToolPolicy là đối tượng giá trị,\n  nhúng vào các cột max_*, used_* và allowlist\n  nên không có bảng riêng.\nend note\n\nnote bottom of AdminPolicy\n  Đúng 1 dòng (id = 1).\n  Phiên sao allowlist và hạn mức lúc tạo.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qR_fsBt3zCiaweIrt0IP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
