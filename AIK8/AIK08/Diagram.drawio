    <mxGraphModel dx="1030" dy="523" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    class admin_policy {\n        +integer id\n        +text_array allowlist\n        +integer default_max_steps\n        +integer default_max_tokens\n        +integer default_max_seconds\n    }\n\n    class sources {\n        +integer id\n        +text kind\n        +text uri\n        +text display_name\n        +boolean enabled\n    }\n\n    class document_chunks {\n        +integer id\n        +integer source_id\n        +integer position\n        +text text\n    }\n\n    class research_sessions {\n        +integer id\n        +text question\n        +text status\n        +text_array allowlist\n        +integer max_steps\n        +integer max_tokens\n        +integer max_seconds\n        +integer used_steps\n        +integer used_tokens\n        +integer used_seconds\n        +timestamptz started_at\n        +timestamptz ended_at\n        +text end_reason\n    }\n\n    class plan_steps {\n        +integer id\n        +integer session_id\n        +integer position\n        +text goal\n        +text status\n    }\n\n    class tool_calls {\n        +integer id\n        +integer session_id\n        +integer step_id\n        +text tool_name\n        +jsonb arguments\n        +text outcome\n        +text guard_decision\n        +text guard_reason\n        +integer duration_ms\n        +timestamptz created_at\n    }\n\n    class evidence {\n        +integer id\n        +integer tool_call_id\n        +integer source_id\n        +text locator\n        +text excerpt\n        +text content_hash\n        +timestamptz retrieved_at\n        +boolean suspicious\n    }\n\n    class guard_findings {\n        +integer id\n        +integer session_id\n        +integer tool_call_id\n        +integer evidence_id\n        +text kind\n        +text severity\n        +text detail\n    }\n\n    class reports {\n        +integer id\n        +integer session_id\n        +text body\n        +text end_reason\n        +timestamptz created_at\n    }\n\n    class claims {\n        +integer id\n        +integer report_id\n        +integer position\n        +text text\n        +text status\n    }\n\n    class citations {\n        +integer claim_id\n        +integer evidence_id\n        +text matched_excerpt\n    }\n\n    sources \&quot;1\&quot; -- \&quot;0..*\&quot; document_chunks : source_id\n    research_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; plan_steps : session_id\n    research_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; tool_calls : session_id\n    plan_steps \&quot;0..1\&quot; -- \&quot;0..*\&quot; tool_calls : step_id\n    tool_calls \&quot;1\&quot; -- \&quot;0..*\&quot; evidence : tool_call_id\n    sources \&quot;1\&quot; -- \&quot;0..*\&quot; evidence : source_id\n    research_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; guard_findings : session_id\n    tool_calls \&quot;0..1\&quot; -- \&quot;0..*\&quot; guard_findings : tool_call_id\n    evidence \&quot;0..1\&quot; -- \&quot;0..*\&quot; guard_findings : evidence_id\n    research_sessions \&quot;1\&quot; -- \&quot;0..1\&quot; reports : session_id\n    reports \&quot;1\&quot; -- \&quot;0..*\&quot; claims : report_id\n    claims \&quot;1\&quot; -- \&quot;0..*\&quot; citations : claim_id\n    evidence \&quot;1\&quot; -- \&quot;0..*\&quot; citations : evidence_id&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JTmABVf7K82hLr57u8h_-1">
