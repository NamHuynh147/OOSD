  <diagram id="EupSBte7h3vrdyyqFU2q" name="ERD">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ERD - AIK-08 (PostgreSQL)\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\n\nentity \&quot;Chính sách mặc định\\n(admin_policy)\&quot; as admin_policy {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * allowlist : text[]\n  * default_max_steps : integer\n  * default_max_tokens : integer\n  * default_max_seconds : integer\n}\n\nentity \&quot;Nguồn dữ liệu\\n(sources)\&quot; as sources {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * kind : text\n  * uri : text\n  * display_name : text\n  * enabled : boolean\n}\n\nentity \&quot;Đoạn tài liệu\\n(document_chunks)\&quot; as document_chunks {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * source_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * text : text\n}\n\nentity \&quot;Phiên tra cứu\\n(research_sessions)\&quot; as research_sessions {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * question : text\n  * status : text\n  * allowlist : text[]\n  * max_steps : integer\n  * max_tokens : integer\n  * max_seconds : integer\n  * used_steps : integer\n  * used_tokens : integer\n  * used_seconds : integer\n  * started_at : timestamptz\n  ended_at : timestamptz\n  end_reason : text\n}\n\nentity \&quot;Bước kế hoạch\\n(plan_steps)\&quot; as plan_steps {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * goal : text\n  * status : text\n}\n\nentity \&quot;Lời gọi tool\\n(tool_calls)\&quot; as tool_calls {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  step_id : integer &lt;&lt;FK&gt;&gt;\n  * tool_name : text\n  * arguments : jsonb\n  * outcome : text\n  * guard_decision : text\n  guard_reason : text\n  * duration_ms : integer\n  * created_at : timestamptz\n}\n\nentity \&quot;Bằng chứng\\n(evidence)\&quot; as evidence {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * tool_call_id : integer &lt;&lt;FK&gt;&gt;\n  * source_id : integer &lt;&lt;FK&gt;&gt;\n  * locator : text\n  * excerpt : text\n  * content_hash : text\n  * retrieved_at : timestamptz\n  * suspicious : boolean\n}\n\nentity \&quot;Cảnh báo của guard\\n(guard_findings)\&quot; as guard_findings {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK&gt;&gt;\n  tool_call_id : integer &lt;&lt;FK&gt;&gt;\n  evidence_id : integer &lt;&lt;FK&gt;&gt;\n  * kind : text\n  * severity : text\n  * detail : text\n}\n\nentity \&quot;Báo cáo\\n(reports)\&quot; as reports {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * session_id : integer &lt;&lt;FK, UNIQUE&gt;&gt;\n  * body : text\n  * end_reason : text\n  * created_at : timestamptz\n}\n\nentity \&quot;Khẳng định\\n(claims)\&quot; as claims {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  * report_id : integer &lt;&lt;FK&gt;&gt;\n  * position : integer\n  * text : text\n  * status : text\n}\n\nentity \&quot;Trích dẫn\\n(citations)\&quot; as citations {\n  * claim_id : integer &lt;&lt;PK, FK&gt;&gt;\n  * evidence_id : integer &lt;&lt;PK, FK&gt;&gt;\n  --\n  * matched_excerpt : text\n}\n\nsources \&quot;1\&quot; -- \&quot;0..*\&quot; document_chunks : có đoạn\nsources \&quot;1\&quot; -- \&quot;0..*\&quot; evidence : là nguồn của\nresearch_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; plan_steps : có bước\nresearch_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; tool_calls : gồm\nresearch_sessions \&quot;1\&quot; -- \&quot;0..*\&quot; guard_findings : ghi nhận\nresearch_sessions \&quot;1\&quot; -- \&quot;0..1\&quot; reports : tạo ra\nplan_steps \&quot;0..1\&quot; -- \&quot;0..*\&quot; tool_calls : thực hiện\ntool_calls \&quot;1\&quot; -- \&quot;0..*\&quot; evidence : sinh ra\ntool_calls \&quot;0..1\&quot; -- \&quot;0..*\&quot; guard_findings : gây ra\nevidence \&quot;0..1\&quot; -- \&quot;0..*\&quot; guard_findings : bị đánh dấu\nreports \&quot;1\&quot; -- \&quot;0..*\&quot; claims : gồm\nclaims \&quot;1\&quot; -- \&quot;0..*\&quot; citations : trích dẫn\nevidence \&quot;1\&quot; -- \&quot;0..*\&quot; citations : được trích\n\nnote right of evidence\n  Bất biến: trigger chặn UPDATE và DELETE\nend note\n\nnote bottom of admin_policy\n  Đúng 1 dòng (id = 1).\n  Phiên sao allowlist và hạn mức lúc tạo.\nend note\n\nlegend right\n  **Cách đọc bội số**\n  1 : đúng một\n  0..1 : không hoặc một\n  0..* : không hoặc nhiều\n  Số đặt cạnh bảng nào là số bản ghi của bảng đó\n  ứng với một bản ghi của bảng ở đầu kia.\nend legend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oq-IFNkeO4lul5TlG04v-176">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
