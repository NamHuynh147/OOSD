        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam classAttributeIconSize 0\nskinparam linetype polyline\nskinparam nodesep 60\nskinparam ranksep 70\n\nskinparam class {\n  BackgroundColor #ECECFF\n  BorderColor #333333\n  BorderThickness 1\n  FontStyle bold\n  AttributeFontStyle bold\n  AttributeFontSize 12\n}\nskinparam ArrowColor black\nskinparam ArrowFontSize 11\nskinparam ArrowFontColor #333366\n\nhide circle\nhide empty members\n\nclass NhanHieu {\n  +maLoai\n  +tenLoai\n  --\n  +themNhanHieu()\n  +suaNhanHieu()\n  +xoaNhanHieu()\n}\n\nclass NhaCungUng {\n  +maNCU\n  +tenNCU\n  +diaChi\n  +soDienThoai\n  --\n  +themNhaCungUng()\n  +suaNhaCungUng()\n  +xoaNhaCungUng()\n}\n\nclass NhanVien {\n  +maNV\n  +hoTen\n  +soDienThoai\n  +diaChi\n  --\n  +lapDonDatHang()\n  +lapHoaDon()\n  +lapPhieuGhiNo()\n}\n\nclass KhachHang {\n  +maKH\n  +tenKH\n  +diaChi\n  +soDienThoai\n  +loaiKhach\n  --\n  +kiemTraKhachQuen()\n}\n\nclass NuocGiaiKhat {\n  +maNGK\n  +tenNGK\n  +donViTinh\n  +soLuongTon\n  +giaGoc\n  +giaBan\n  +maNCU\n  --\n  +kiemTraTonKho()\n  +capNhatSoLuongTon()\n}\n\nclass DonDatHang {\n  +maDDH\n  +ngayDatHang\n  +ngayNhanHang\n  +soDotGiao\n  +trangThai\n  --\n  +lapDonDatHang()\n  +guiDonDatHang()\n  +kiemTraSoDotGiao()\n}\n\nclass HoaDon {\n  +maHD\n  +ngayLap\n  +tongTien\n  +trangThaiThanhToan\n  --\n  +lapHoaDon()\n  +tinhTongTien()\n  +thanhToan()\n}\n\nclass PhieuGhiNo {\n  +maPGN\n  +thongTinKhachQuen\n  +ngayLap\n  +soTienNo\n  +ngayDuKienTra\n  +lyDoNo\n  +trangThai\n  --\n  +lapPhieuGhiNo()\n  +thanhToanNo()\n}\n\nclass PhieuNhanHang {\n  +maDDH\n  +maNGK\n  +soLuongDat\n  +soTienPhaiTra\n  --\n  +lapPhieuNhanHang()\n  +tinhSoTienPhaiTra()\n}\n\nclass ChiTietHoaDon {\n  +maCTHD\n  +soLuong\n  +donGia\n  +thanhTien\n  --\n  +tinhThanhTien()\n}\n\nclass PhieuGiaoHang {\n  +maPGH\n  +ngayGiao\n  +soDotGiao\n  +tongTien\n  --\n  +lapPhieuGiaoHang()\n  +tinhTongTien()\n}\n\nclass PhieuHenGiaoHang {\n  +maPHG\n  +ngayHen\n  +soLuongHen\n  +trangThai\n  --\n  +lapPhieuHen()\n  +capNhatPhieuHen()\n  +xacNhanGiaoHang()\n}\n\nclass ChiTietPhieuGiaoHang {\n  +maCTPGH\n  +soLuongGiao\n  +donGia\n  +thanhTien\n  --\n  +tinhThanhTien()\n}\n\n&#39; ===== Quan hệ =====\nNhanHieu \&quot;1\&quot; -- \&quot;0..*\&quot; NuocGiaiKhat : có\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; NuocGiaiKhat : cung cấp\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : nhận\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : lập\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : lập\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : lập\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : mua\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : có\n\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuNhanHang : được đặt\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon : bán\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuGiaoHang : được giao\n\nDonDatHang \&quot;1\&quot; -- \&quot;1..*\&quot; PhieuNhanHang : có\nDonDatHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaoHang : được giao\n\nHoaDon \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHoaDon : gồm\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiaoHang : có\n\nPhieuGiaoHang \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuGiaoHang : gồm\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="c2entyBWcIsfxqk5xVer-1">
