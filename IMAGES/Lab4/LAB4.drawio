        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Quản trị viên\&quot; as QTV\nactor \&quot;Hệ thống quản lý sản phẩm\&quot; as SP\nactor \&quot;Dịch vụ thanh toán\&quot; as TT\nactor \&quot;Dịch vụ email\&quot; as EMAIL\n\nrectangle \&quot;HỆ THỐNG e-SHOPPING\&quot; {\n\n    usecase \&quot;Đăng ký tài khoản\&quot; as UC1\n    usecase \&quot;Đăng nhập\&quot; as UC2\n    usecase \&quot;Tìm kiếm sản phẩm\&quot; as UC3\n    usecase \&quot;Xem sản phẩm\&quot; as UC4\n    usecase \&quot;Thêm vào giỏ hàng\&quot; as UC5\n    usecase \&quot;Đặt hàng\&quot; as UC6\n    usecase \&quot;Thanh toán\&quot; as UC7\n    usecase \&quot;Theo dõi đơn hàng\&quot; as UC8\n    usecase \&quot;Nhận thông báo email\&quot; as UC9\n\n    usecase \&quot;Quản lý đơn hàng\&quot; as UC10\n    usecase \&quot;Quản lý tài khoản\&quot; as UC11\n\n    usecase \&quot;Quản lý sản phẩm\&quot; as UC12\n    usecase \&quot;Xác thực thanh toán\&quot; as UC13\n    usecase \&quot;Gửi email\&quot; as UC14\n}\n\nKH --&gt; UC1\nKH --&gt; UC2\nKH --&gt; UC3\nKH --&gt; UC4\nKH --&gt; UC5\nKH --&gt; UC6\nKH --&gt; UC7\nKH --&gt; UC8\nKH --&gt; UC9\nKH --&gt; UC11\n\nQTV --&gt; UC10\nQTV --&gt; UC12\n\nSP --&gt; UC3\nSP --&gt; UC4\nSP --&gt; UC12\n\nTT --&gt; UC13\nEMAIL --&gt; UC14\n\nUC6 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DrqaP8HWIUEbNAXhF89h-1">
