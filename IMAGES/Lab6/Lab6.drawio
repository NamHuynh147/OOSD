        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\nautonumber \&quot;&lt;b&gt;0\&quot;\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam maxMessageSize 400\nskinparam ParticipantPadding 30\nskinparam SequenceMessageAlignment left\n\nskinparam sequence {\n  ArrowColor black\n  ArrowThickness 1\n  LifeLineBorderColor #555555\n  LifeLineBackgroundColor white\n  ParticipantBorderColor black\n  ParticipantBackgroundColor white\n  ActorBorderColor black\n  ActorBackgroundColor white\n  BoundaryBorderColor black\n  BoundaryBackgroundColor white\n  ControlBorderColor black\n  ControlBackgroundColor white\n  EntityBorderColor black\n  EntityBackgroundColor white\n}\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;NV CSKH\&quot; as NV\nboundary FormDangKy\ncontrol DangKyControl\nentity BenhNhan\nentity HoSoBenhAn\nentity HoaDon\n\nBN -&gt; NV : 1. Cung cấp thông tin &amp; Ảnh 3x4\nNV -&gt; FormDangKy : 2. Nhập thông tin phiếu đăng ký\nFormDangKy -&gt; DangKyControl : 3. taoPhieuDangKy(thongTin)\nDangKyControl -&gt; BenhNhan : 4. create(thongTin)\nNV -&gt; FormDangKy : 5. Thu lệ phí hằng năm\nFormDangKy -&gt; DangKyControl : 6. xacNhanDongFee(maBenhNhan, soTien)\nDangKyControl -&gt; HoaDon : 7. createHoaDonLePhi(maBenhNhan, soTien)\nDangKyControl -&gt; HoSoBenhAn : 8. createHoSo(maBenhNhan, hanThuPhi)\nHoSoBenhAn --&gt; DangKyControl : 9. maHoSo\nDangKyControl --&gt; FormDangKy : 10. Thông báo khởi tạo thành công\nFormDangKy --&gt; NV : 11. In trang bìa Hồ sơ bệnh án\nNV --&gt; BN : 12. Phát Hồ sơ bệnh án\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HjvIjzRJVD2MHQ3txoUv-1">
