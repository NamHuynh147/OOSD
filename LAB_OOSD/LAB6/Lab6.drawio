<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="K2EfhRb-7CHR_bAmajiV">
    <mxGraphModel dx="2146" dy="1090" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% 1. Lớp Bệnh nhân\n    class BenhNhan {\n        -String maBenhNhan\n        -String hoTen\n        -Date ngaySinh\n        -String diaChi\n        -String soDienThoai\n        -String anhCha\n        +dangKyThongTin() void\n        +capNhatThongTin() void\n        +xemLichSuKham() List~PhieuKhamBenh~\n    }\n\n    %% 2. Lớp Phiếu đăng ký\n    class PhieuDangKy {\n        -String maPhieuDK\n        -Date ngayLap\n        -String hoTen\n        -String diaChi\n        -Date ngaySinh\n        -String soDienThoai\n        -String anh3x4\n        -String trangThai\n        +taoPhieuDK() void\n        +xacNhanThongTin() boolean\n    }\n\n    %% 3. Lớp Hồ sơ bệnh án\n    class HoSoBenhAn {\n        -String maHoSo\n        -Date ngayTao\n        -String maBenhNhan\n        -Date hanThuPhi\n        -String trangThai\n        +taoHoSo() void\n        +traCuuHoSo() HoSoBenhAn\n        +giaHanLePhi() void\n    }\n\n    %% 4. Lớp Phiếu khám bệnh\n    class PhieuKhamBenh {\n        -String maPhieuKham\n        -String maHoSo\n        -DateTime ngayGioKham\n        -String maBacSi\n        -String maKhoa\n        -String trieuChung\n        -String chanDoan\n        -String loaiKham\n        +taoPhieuKham() void\n        +ghiNhanTrieuChung() void\n        +capNhatChanDoan() void\n    }\n\n    %% 5. Lớp Bác sĩ\n    class BacSi {\n        -String maBacSi\n        -String hoTen\n        -String chuyenKhoa\n        -String soDienThoai\n        -String maKhoa\n        +khamBenh() void\n        +keToaThuoc() ToaThuoc\n        +chiDinhXetNghiem() PhieuXetNghiem\n        +xemLichSuBenhAn() HoSoBenhAn\n    }\n\n    %% 6. Lớp Khoa điều trị\n    class KhoaDieuTri {\n        -String maKhoa\n        -String tenKhoa\n        -String moTa\n        +layDanhSachBacSi() List~BacSi~\n    }\n\n    %% 7. Lớp Toa thuốc\n    class ToaThuoc {\n        -String maToaThuoc\n        -String maPhieuKham\n        -Date ngayKe\n        -String loiDangDung\n        +taoToaThuoc() void\n        +inToaThuoc() void\n    }\n\n    %% 8. Lớp Chi tiết toa thuốc\n    class ChiTietToaThuoc {\n        -String maChiTiet\n        -String maToaThuoc\n        -String maThuoc\n        -int soLuong\n        -String lieuDung\n        -String cachDung\n        +tinhTienThuoc() double\n    }\n\n    %% 9. Lớp Thuốc\n    class Thuoc {\n        -String maThuoc\n        -String tenThuoc\n        -String donViTinh\n        -double donGia\n        -String tacDungPhu\n        +capNhatGia() void\n    }\n\n    %% 10. Lớp Phiếu xét nghiệm (Lấy thông tin cơ bản)\n    class PhieuXetNghiem {\n        -String maPhieuXetNghiem\n        -String maPhieuKham\n        -String ketQua\n    }\n\n    %% 11. Lớp Nhân viên CSKH\n    class NhanVienCSKH {\n        -String maNhanVien\n        -String hoTen\n        -String soDienThoai\n        +tiepNhanDangKy() PhieuDangKy\n        +datCuocHen() CuocHen\n        +ghiNhanGiaSuatVien() void\n        +lapHoaDon() HoaDon\n    }\n\n    %% 12. Lớp Hóa đơn\n    class HoaDon {\n        -String maHoaDon\n        -String maBenhNhan\n        -String loaiHoaDon\n        -Date ngayLap\n        -double tongTien\n        -String trangThai\n        +tinhTongTien() double\n        +inHoaDon() void\n    }\n\n    %% === CÁC MỐI QUAN HỆ (RELATIONSHIPS) ===\n    \n    %% Bệnh nhân và các chứng từ liên quan\n    BenhNhan \&quot;1\&quot; --&gt; \&quot;1\&quot; HoSoBenhAn : Sở hữu\n    BenhNhan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKy : Đăng ký\n    BenhNhan \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HoaDon : Thanh toán\n\n    %% Hồ sơ bệnh án\n    HoSoBenhAn \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuKhamBenh : Chứa\n\n    %% Nhân viên và quy trình\n    NhanVienCSKH \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuDangKy : Tiếp nhận\n    NhanVienCSKH \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HoaDon : Lập\n\n    %% Cơ cấu tổ chức bệnh viện\n    KhoaDieuTri \&quot;1\&quot; *-- \&quot;1..*\&quot; BacSi : Gồm các\n\n    %% Quá trình khám bệnh\n    BacSi \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuKhamBenh : Phụ trách\n    KhoaDieuTri \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PhieuKhamBenh : Thuộc khoa\n    \n    PhieuKhamBenh \&quot;1\&quot; *-- \&quot;0..1\&quot; ToaThuoc : Sinh ra\n    PhieuKhamBenh \&quot;1\&quot; *-- \&quot;0..*\&quot; PhieuXetNghiem : Có chỉ định\n\n    %% Kê đơn thuốc\n    ToaThuoc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietToaThuoc : Gồm\n    ChiTietToaThuoc \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Thuoc : Là loại thuốc&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ewqlIuA0lnROQi66B8BQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=15;fontStyle=1" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
