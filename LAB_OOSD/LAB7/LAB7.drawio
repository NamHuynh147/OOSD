        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - Hệ thống Quản lý Nhân sự (Style StarUML)\n\n&#39; Cấu hình giao diện giống StarUML\nskinparam class {\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n    AttributeIconSize 0\n    FontName Arial\n}\nskinparam shadowing false\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 60\n\nclass PhongBan {\n    - maPhongBan : String (PK)\n    - tenPhongBan : String\n    - maTruongPhong : String (FK)\n    - moTa : String\n    + layDanhSachNhanVien() : List\n    + lapKeHoachPhanCong() : KeHoachPhanCong\n}\n\nclass NhanVien {\n    - maNV : String (PK)\n    - hoTen : String\n    - ngaySinh : Date\n    - gioiTinh : String\n    - diaChi : String\n    - soDienThoai : String\n    - email : String\n    - trangThai : String\n    - maPhongBan : String (FK)\n    + capNhatThongTin() : void\n    + xemLichSuQuyetDinh() : List\n    + xemBangLuongThang() : BangLuongThang\n}\n\nclass ChucVu {\n    - maChucVu : String (PK)\n    - tenChucVu : String\n    - phuCapMacDinh : double\n    + capNhatPhuCap() : void\n}\n\nclass PhieuPhuTroi {\n    - maPhieuPhuTroi : String (PK)\n    - soPhieu : String\n    - maPhongBan : String (FK)\n    - ngayLap : Date\n    - nguoiLap : String\n    + taoPhieuPhuTroi() : void\n    + duyetPhieuPhuTroi() : void\n}\n\nclass KeHoachPhanCong {\n    - maKeHoach : String (PK)\n    - maPhongBan : String (FK)\n    - tuNgay : Date\n    - denNgay : Date\n    - nguoiLap : String\n    + taoKeHoach() : void\n    + guiBanChamCong() : void\n}\n\nclass QuyetDinhChucVu {\n    - maQDChucVu : String (PK)\n    - soQuyetDinh : String\n    - maNV : String (FK)\n    - maChucVu : String (FK)\n    - phuCapChucVu : double\n    - ngayHieuLuc : Date\n    + taoQDChucVu() : void\n}\n\nclass ChiTietPhuTroi {\n    - maCTPhuTroi : String (PK)\n    - maPhieuPhuTroi : String (FK)\n    - maNV : String (FK)\n    - ngayPhuTroi : Date\n    - soGioPhuTroi : double\n    - hinhThucPhuTroi : String\n    - heSoLuong : double\n    + tinhGioPhuTroiQuyDoi() : double\n}\n\nclass QuyetDinhKTKL {\n    - maQDKTKL : String (PK)\n    - soQuyetDinh : String\n    - loaiQuyetDinh : String\n    - doiTuong : String\n    - maNV : String (FK)\n    - maPhongBan : String (FK)\n    - ngayKy : Date\n    - soTien : double\n    - lyDo : String\n    + taoQuyetDinh() : void\n    + duyetQuyetDinh() : void\n}\n\nclass PhieuThuChiKTKL {\n    - maPhieuTC : String (PK)\n    - soPhieu : String\n    - maQDKTKL : String (FK)\n    - loaiPhieu : String\n    - soTien : double\n    - ngayLap : Date\n    - hinhThucGiaoDich : String\n    + taoPhieuTC() : void\n    + inPhieuTC() : void\n}\n\nclass HoSoBaoHiem {\n    - maBaoHiem : String (PK)\n    - maNV : String (FK)\n    - soBHXH : String\n    - soBHYT : String\n    - tyLeDongBHXH : double\n    - tyLeDongBHYT : double\n    - ngayCap : Date\n    + taoHoSoBaoHiem() : void\n    + tinhTienBaoHiem() : double\n}\n\nclass PhieuChamCong {\n    - maPhieuChamCong : String (PK)\n    - maNV : String (FK)\n    - soNgayCongThucTe : double\n    - soNgayNghiPhep : double\n    - soNgayNghiKhongPhep : double\n    + ghiNhanChamCong() : void\n    + tinhTongNgayCong() : double\n}\n\nclass QuyetDinhTuyenDung {\n    - maQDTuyenDung : String (PK)\n    - soQuyetDinh : String\n    - maNV : String (FK)\n    - maPhongBan : String (FK)\n    - ngayKy : Date\n    - thoiGianThuViec : int\n    - luongThuViec : double\n    - dieuKhoan : String\n    + taoQDTuyenDung() : void\n    + inQuyetDinh() : void\n}\n\nclass HopDongLaoDong {\n    - maHopDong : String (PK)\n    - soHopDong : String\n    - maNV : String (FK)\n    - loaiHopDong : String\n    - ngayKy : Date\n    - ngayBatDau : Date\n    - ngayKetThuc : Date\n    - noiDungHD : String\n    + taoHopDong() : void\n    + giaHanHopDong() : void\n    + thanhLyHopDong() : void\n}\n\nclass BangLuongThang {\n    - maBangLuong : String (PK)\n    - thangNam : String\n    - maNV : String (FK)\n    - luongCoBan : double\n    - tienLuongCongThucTe : double\n    - tienPhuTroi : double\n    - tienPhuCap : double\n    - tienKhenThuong : double\n    - tienKhauTruKyLuat : double\n    - tienKhauTruBaoHiem : double\n    - luongThucNhan : double\n    + tinhLuongThucNhan() : double\n    + xuatPhieuLuong() : void\n}\n\nclass QuyetDinhLuong {\n    - maQDLuong : String (PK)\n    - soQuyetDinh : String\n    - maNV : String (FK)\n    - luongCoBan : double\n    - phuCapLuong : double\n    - phuCapDocHai : double\n    - ngayHieuLuc : Date\n    + taoQDLuong() : void\n    + dieuChinhLuong() : void\n}\n\nclass ChiTietPhanCong {\n    - maCTPhanCong : String (PK)\n    - maKeHoach : String (FK)\n    - maNV : String (FK)\n    - ngayLamViec : Date\n    - caLamViec : String\n    + capNhatCaLam() : void\n}\n\n&#39; ==========================================\n&#39; MỐI QUAN HỆ (RELATIONSHIPS)\n&#39; ==========================================\n\n&#39; Tầng trên cùng: Phòng Ban và các lớp liên quan\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;0..1\&quot; --&gt; \&quot;1\&quot; NhanVien : TruongPhong\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuPhuTroi\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong\n\n&#39; Tầng chức vụ\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\n&#39; Tầng chi tiết phụ trội &amp; phân công (Composition)\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhanCong\n\n&#39; Liên kết từ Nhân viên đến các chứng từ, hồ sơ (Tầng dưới)\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhKTKL\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuongThang\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\n\n&#39; Liên kết phụ\nQuyetDinhKTKL \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuChiKTKL\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mL6zeUbgIed7mu0YfIbh-1">
