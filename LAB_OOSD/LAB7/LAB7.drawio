  <diagram id="VRdduQhK9NfFFDtwCUUY" name="activity">
    <mxGraphModel dx="2575" dy="1308" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - Quy trình Tuyển dụng &amp; Thử việc\n\n&#39; Cấu hình giao diện (có thể bỏ nếu muốn dùng mặc định của draw.io)\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\nskinparam ArrowColor black\nskinparam shadowing false\n\n|Ứng viên / Nhân viên|\nstart\n:Nộp hồ sơ tuyển dụng;\n\n|Phòng Nhân sự|\n:Nhập thông tin ứng viên;\n\n|Hệ thống|\n:Khởi tạo hồ sơ thử việc;\n\n|Phòng Nhân sự|\n:Lập Quyết định tuyển dụng thử việc;\n\n|Ban Giám đốc|\n:Duyệt &amp; Ký Quyết định thử việc;\n\n|Phòng Nhân sự|\n:Bàn giao QĐ &amp; Phân công phòng ban;\n\n|Ứng viên / Nhân viên|\n:Thực hiện thử việc tại phòng ban;\n\n|Phòng Nhân sự|\n:Theo dõi &amp; Đánh giá kết quả thử việc;\nif (Đạt yêu cầu thử việc?) then (Không)\n  :Chấm dứt thử việc &amp; Thanh lý;\n  stop\nelse (Có)\n  :Soạn Hợp đồng lao động chính thức;\n  \n  |Ban Giám đốc|\n  :Ký Hợp đồng lao động, QĐ Lương &amp; QĐ Chức vụ;\n  \n  |Phòng Nhân sự|\n  if (Loại Hợp đồng?) then (Hợp đồng Dài hạn)\n    :Lập Hồ sơ BHYT &amp; BHXH;\n  else (Hợp đồng Ngắn hạn)\n  endif\n  \n  |Hệ thống|\n  :Lưu CSDL &amp; Sinh Mã Nhân viên chính thức;\n  \n  |Phòng Nhân sự|\n  :In &amp; Bàn giao HĐ, QĐ cho Nhân viên;\n  \n  |Ứng viên / Nhân viên|\n  :Nhận Hợp đồng &amp; Quyết định chính thức;\n  stop\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qgOPhsiFcDhGIAhpFcTz-38">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Ứng viên / Nhân viên" plantUmlId="lane_77" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;shadow=0;" plantUmlBaseValue="Ứng viên / Nhân viên" id="qgOPhsiFcDhGIAhpFcTz-39">
          <mxCell parent="qgOPhsiFcDhGIAhpFcTz-38" style="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;shadow=0;" vertex="1">
            <mxGeometry height="990" width="270" x="40" y="174" as="geometry" />
