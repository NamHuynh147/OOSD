        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nleft to right direction\n\nclass LoaiNGK {\n  + maLoai: String [PK]\n  + tenLoai: String\n  + moTa: String\n  --\n  + themLoai(): void\n  + capNhatLoai(): void\n}\n\nclass NhaCungUng {\n  + maNCU: String [PK]\n  + tenNCU: String\n  + diaChi: String\n  + soDienThoai: String\n  --\n  + themNhaCungUng(): void\n  + capNhatThongTin(): void\n}\n\nclass NuocGiaiKhat {\n  + maNGK: String [PK]\n  + tenNGK: String\n  + donViTinh: String\n  + soLuongTon: int\n  + donGiaBan: double\n  + maLoai: String [FK]\n  + maNCU: String [FK]\n  --\n  + capNhatTonKho(soLuong: int): void\n  + kiemTraTonKho(soLuongYeuCau: int): boolean\n}\n\nclass NhanVien {\n  + maNV: String [PK]\n  + hoTen: String\n  + chucVu: String\n  + soDienThoai: String\n  --\n  + capNhatThongTin(): void\n}\n\nclass KhachHang {\n  + maKH: String [PK]\n  + tenKH: String\n  + diaChi: String\n  + soDienThoai: String\n  + loaiKhachHang: String\n  --\n  + capNhatLoaiKhach(): void\n}\n\nclass DonDatHang {\n  + maDDH: String [PK]\n  + ngayDat: Date\n  + ngayNhanDuKien: Date\n  + trangThai: String\n  + maNCU: String [FK]\n  + maNV: String [FK]\n  --\n  + taoDonDatHang(): void\n  + demSoDotGiao(): int\n}\n\nclass ChiTietDDH {\n  + maDDH: String [PK/FK]\n  + maNGK: String [PK/FK]\n  + soLuongDat: int\n  --\n  + capNhatSoLuongDat(soLuong: int): void\n}\n\nclass PhieuGiaoHang {\n  + maPGH: String [PK]\n  + ngayGiao: Date\n  + dotGiao: int\n  + phiThanhToan: double\n  + maDDH: String [FK]\n  + maNV: String [FK]\n  --\n  + taoPhieuGiao(): void\n  + xacNhanNhapKho(): void\n}\n\nclass ChiTietPhieuGiao {\n  + maPGH: String [PK/FK]\n  + maNGK: String [PK/FK]\n  + soLuongGiao: int\n  + donGiaNhap: double\n  --\n  + tinhThanhTien(): double\n}\n\nclass HoaDon {\n  + maHD: String [PK]\n  + ngayLap: Date\n  + tongTien: double\n  + trangThaiThanhToan: String\n  + maKH: String [FK]\n  + maNV: String [FK]\n  --\n  + taoHoaDon(): void\n  + tinhTongTien(): double\n}\n\nclass ChiTietHoaDon {\n  + maHD: String [PK/FK]\n  + maNGK: String [PK/FK]\n  + soLuong: int\n  + donGia: double\n  --\n  + tinhThanhTien(): double\n}\n\nclass PhieuHenGiao {\n  + maPhieuHen: String [PK]\n  + ngayHenGiao: Date\n  + dotGiao: int\n  + trangThai: String\n  + maHD: String [FK]\n  + maNV: String [FK]\n  --\n  + taoPhieuHen(): void\n  + xacNhanGiaoThanhCong(): void\n}\n\nclass ChiTietPhieuHen {\n  + maPhieuHen: String [PK/FK]\n  + maNGK: String [PK/FK]\n  + soLuongHen: int\n  --\n  + capNhatSoLuongHen(soLuong: int): void\n}\n\nclass PhieuGhiNo {\n  + maPhieuNo: String [PK]\n  + ngayLap: Date\n  + soTienNo: double\n  + ngayDuKienTra: Date\n  + lyDoNo: String\n  + trangThai: String\n  + maKH: String [FK]\n  + maHD: String [FK]\n  + maNV: String [FK]\n  --\n  + taoPhieuGhiNo(): void\n  + thanhToanNo(soTien: double): void\n}\n\n&#39; Quan hệ giữa các Class\nLoaiNGK \&quot;1\&quot; -- \&quot;0..*\&quot; NuocGiaiKhat : có &gt;\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; NuocGiaiKhat : cung cấp &gt;\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : nhận &gt;\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : lập &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaoHang : tiếp nhận &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : lập &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiao : lập &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : lập &gt;\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon : mua &gt;\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo : nợ &gt;\n\nDonDatHang \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietDDH : có &gt;\nDonDatHang \&quot;1\&quot; -- \&quot;0..3\&quot; PhieuGiaoHang : được giao &gt;\n\nPhieuGiaoHang \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuGiao : gồm &gt;\n\nHoaDon \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietHoaDon : gồm &gt;\nHoaDon \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuHenGiao : có &gt;\nHoaDon \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuGhiNo : có &gt;\n\nPhieuHenGiao \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietPhieuHen : gồm &gt;\n\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDDH : được đặt &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuGiao : được giao &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon : bán &gt;\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuHen : hẹn giao &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vDGs1tpGYUHbkSomDEAs-1">
