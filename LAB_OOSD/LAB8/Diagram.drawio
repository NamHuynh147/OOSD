  <diagram id="eimRyABxjNFr_fhTznPp" name="Sequence">
    <mxGraphModel dx="1776" dy="902" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; ============ STYLE TỐI GIẢN ============\nskinparam monochrome true\nskinparam style strictuml\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam sequenceMessageAlign left\nskinparam shadowing false\n\nautonumber\n\ntitle &lt;b&gt;Sequence Diagram - Quy trình lập Phiếu Ghi Nợ&lt;/b&gt;\n\nactor \&quot;NV Bán hàng\&quot; as NV\nboundary \&quot;FormPhieuGhiNo\&quot; as Form\ncontrol \&quot;PhieuGhiNoService\&quot; as Service\nentity \&quot;KhachHang\&quot; as KH\nentity \&quot;HoaDon\&quot; as HD\nentity \&quot;PhieuGhiNo\&quot; as PGN\ndatabase \&quot;SQL Server DB\&quot; as DB\n\nNV -&gt; Form : MoFormLapPhieuNo(maHD)\nactivate Form\n\nForm -&gt; Service : layThongTinHoaDon(maHD)\nactivate Service\n\nService -&gt; HD : getHoaDon(maHD)\nactivate HD\nHD --&gt; Service : thongTinHoaDon\ndeactivate HD\n\nService --&gt; Form : hienThiThongTin(HD)\ndeactivate Service\n\nNV -&gt; Form : Nhập Ngày Hẹn Trả, Số Tiền Nợ, Lý Do Nợ\nNV -&gt; Form : Click \&quot;Lưu Phiếu Ghi Nợ\&quot;\n\nForm -&gt; Service : taoPhieuGhiNo(maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\nactivate Service\n\nService -&gt; KH : kiemTraKhachQuen(maKH)\nactivate KH\nKH --&gt; Service : isKhachQuen == true\ndeactivate KH\n\nalt Khách hàng là Khách quen\n    Service -&gt; PGN : create(maPhieuNo, maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\n    activate PGN\n    PGN -&gt; PGN : doTuongPGN\n    PGN --&gt; Service : ok\n    deactivate PGN\n    \n    Service -&gt; HD : capNhatTrangThai(\&quot;Ghi nợ\&quot;)\n    activate HD\n    HD --&gt; Service : ok\n    deactivate HD\n    \n    Service -&gt; DB : INSERT INTO PhieuGhiNo &amp; UPDATE HoaDon (Transaction)\n    activate DB\n    DB --&gt; Service : Transaction Committed Success\n    deactivate DB\n    \n    Service --&gt; Form : Thông báo \&quot;Lập phiếu ghi nợ thành công\&quot;\n    deactivate Service\n    Form --&gt; NV : Hiển thị thông báo &amp; in phiếu nợ\nelse Không phải Khách quen\n    Service --&gt; Form : Báo lỗi \&quot;Khách vãng lai không được phép ghi nợ\&quot;\n    deactivate Service\n    Form --&gt; NV : Hiển thị thông báo lỗi\nend\n\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7ZeRdKUT2yVdgGAA3ugd-1">
