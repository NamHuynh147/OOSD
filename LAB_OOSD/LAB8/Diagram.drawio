  <diagram id="wSLdO_G4gAOi9CSBnqIy" name="Activity">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; ============ STYLE TỐI GIẢN ============\nskinparam monochrome true\nskinparam style strictuml\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam ArrowColor black\nskinparam ActivityBorderColor black\nskinparam SwimlaneBorderColor black\nskinparam ActivityBackgroundColor white\nskinparam ActivityDiamondBackgroundColor white\n\ntitle &lt;b&gt;Activity Diagram - Quy trình bán hàng NGK&lt;/b&gt;\n\n|Khách hàng|\nstart\n:Yêu cầu mua danh sách NGK;\n\n|Nhân viên Bán hàng|\n:Nhận thông tin khách hàng và sản phẩm;\n\n|Hệ thống|\n:Kiểm tra tồn kho từng mặt hàng NGK;\n\nif (Tồn kho đủ?) then (Đủ)\n  :Tính tổng tiền Hóa đơn;\n  :Trừ số lượng tồn kho NGK;\nelse (Thiếu)\n  :Tính toán số lượng thực có;\n  |Nhân viên Bán hàng|\n  if (Loại khách hàng?) then (Khách vãng lai)\n    :Báo khách số lượng thực có;\n    if (Khách đồng ý?) then (Đồng ý)\n      |Hệ thống|\n      :Lập Hóa đơn theo số thực có;\n    else (Không)\n      stop\n    endif\n  else (Khách quen)\n    :Thỏa thuận các đợt hẹn giao;\n    |Hệ thống|\n    :Lập Hóa đơn theo tổng lượng mua;\n    :Tạo Phiếu hẹn giao nhiều đợt;\n  endif\nendif\n\n|Hệ thống|\nif (Hình thức thanh toán?) then (Ghi nợ - Khách quen)\n  :Lập Phiếu ghi nợ (Số tiền, ngày hẹn trả);\nelse (Thanh toán ngay)\nendif\n\n|Nhân viên Bán hàng|\n:Thu tiền và Giao Hóa đơn (kèm Phiếu hẹn / Phiếu nợ);\n\n|Nhân viên Kho|\n:Xuất kho và Giao hàng đợt 1 (số lượng thực có);\n\n|Khách hàng|\n:Nhận hàng và Hóa đơn đợt 1;\n\n|Hệ thống|\nif (Còn đợt hẹn giao?) then (Có - Khách quen)\n  |Nhân viên Kho|\n  repeat\n    :Nhập hàng NGK mới về kho;\n    :Kiểm tra Phiếu hẹn đến hạn;\n    :Xuất kho và Giao đợt tiếp theo;\n    |Hệ thống|\n    :Cập nhật trạng thái Phiếu hẹn;\n  repeat while (Đã giao đủ?) is (Chưa)\n  -&gt; Đã đủ;\n  \n  |Khách hàng|\n  :Nhận toàn bộ NGK theo Hóa đơn;\nelse (Không)\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="j04zjlRCbb5LIoeNnup1-1">
